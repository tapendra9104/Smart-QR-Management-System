# === Required ===
# Generate a strong secret: openssl rand -base64 48
APP_JWT_SECRET=

# === URLs ===
BACKEND_API_URL=http://localhost:8081
GATEWAY_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# === JWT Configuration ===
APP_JWT_ACCESS_TOKEN_TTL_MINUTES=1440
APP_JWT_REFRESH_TOKEN_TTL_DAYS=7

# === Redirect Security ===
APP_REDIRECT_SIGNING_SECRET=
APP_REQUIRE_SIGNED_REDIRECTS=true

# === Rate Limiting ===
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
APP_RATE_LIMIT_PUBLIC_RESOLVE_REQUESTS_PER_MINUTE=240

# === Data Retention ===
APP_RETENTION_SCAN_EVENTS_DAYS=365
APP_RETENTION_AUDIT_LOGS_DAYS=730
APP_RETENTION_REFRESH_TOKENS_DAYS=30

# === Feature Flags ===
APP_MESSAGING_ENABLED=true
APP_ANALYTICS_OLAP_ENABLED=true

# === Email / SMTP ===
# Set APP_MAIL_ENABLED=true and configure SMTP to send real emails
# For Gmail: host=smtp.gmail.com, port=587, use App Password
# For SendGrid: host=smtp.sendgrid.net, port=587, username=apikey
APP_MAIL_ENABLED=false
APP_MAIL_FROM_ADDRESS=noreply@qrmanager.app
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# === PostgreSQL ===
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/seqlams
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# === Redis ===
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=redispass
SPRING_DATA_REDIS_TIMEOUT=5s

# === RabbitMQ ===
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# === ClickHouse ===
CLICKHOUSE_JDBC_URL=jdbc:clickhouse://localhost:8123/default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
