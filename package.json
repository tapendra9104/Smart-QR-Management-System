{
  "name": "qr-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "next dev",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run",
    "dev:backend:local": "mvn -f backend/pom.xml -Dspring-boot.run.profiles=local spring-boot:run",
    "dev:gateway": "mvn -f gateway/pom.xml spring-boot:run",
    "build": "next build",
    "build:backend": "mvn -f backend/pom.xml -DskipTests package",
    "build:gateway": "mvn -f gateway/pom.xml -DskipTests package",
    "test:backend": "mvn -f backend/pom.xml test",
    "test:gateway": "mvn -f gateway/pom.xml test",
    "test:smoke:api": "node scripts/smoke-stack.mjs",
    "test:smoke:browser": "node scripts/browser-smoke.mjs",
    "test:smoke:browser:install": "npx playwright install chromium",
    "start": "next start",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:watch": "vitest",
    "test:load": "k6 run scripts/load-test.js",
    "lint": "eslint ."
  },
